<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MinecraftLauncher.Desktop.Views.MainWindow"
        Title="✨ Minecraft 启动器"
        Width="1000" Height="650"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBg}">

    <Grid ColumnDefinitions="220,*">

        <!-- 左侧导航栏 -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}">
            <Grid RowDefinitions="Auto,*,Auto,Auto">
                <!-- Logo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="18,24,18,8">
                    <Border Width="50" Height="50" CornerRadius="16" Background="{StaticResource AccentPink}">
                        <TextBlock Text="✦" FontSize="30" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="MC 启动器" FontSize="17" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="欢乐版" FontSize="11" Foreground="#FFE0D0FF" />
                    </StackPanel>
                </StackPanel>

                <!-- 导航菜单 -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,8,10,8" Spacing="4">
                        <Button x:Name="NavHome" Classes="nav" Click="OnNavHome" Content="🏠 首页" />
                        <Button x:Name="NavDownload" Classes="nav" Click="OnNavDownload" Content="📥 下载游戏" />
                        <Button x:Name="NavVersions" Classes="nav" Click="OnNavVersions" Content="📦 已安装" />
                        <TextBlock Text="资源中心" Classes="dim" Margin="10,16,0,6" FontSize="12" Foreground="#FFE0D0FF" />
                        <Button x:Name="NavMods" Classes="nav" Click="OnNavMods" Content="🧩 模组" />
                        <Button x:Name="NavResourcePacks" Classes="nav" Click="OnNavResourcePacks" Content="🎨 资源包" />
                        <Button x:Name="NavShaders" Classes="nav" Click="OnNavShaders" Content="✨ 光影" />
                        <Button x:Name="NavTextures" Classes="nav" Click="OnNavTextures" Content="🖼 材质包" />
                        <Button x:Name="NavModpacks" Classes="nav" Click="OnNavModpacks" Content="🎁 整合包" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 用户区域 -->
                <Border Grid.Row="2" Margin="14,0,14,10">
                    <StackPanel Spacing="10">
                        <!-- 未登录状态 -->
                        <Border x:Name="NotLoggedInPanel" Background="Transparent" CornerRadius="14" Padding="14" BorderBrush="#FFE0D0FF" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" x:Name="StatusDot" Fill="#FFB3A0C3" />
                                    <TextBlock x:Name="UserStatus" Text="未登录" FontSize="13" Foreground="#FFE0D0FF" FontWeight="SemiBold" />
                                </StackPanel>
                                <Button Classes="primary" Click="OnOpenLogin" Height="38" Padding="0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="🔐" FontSize="14" />
                                        <TextBlock Text="登录 / 注册" FontSize="14" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="点击上方按钮登录账号" Classes="dim" FontSize="11" Foreground="#FFE0D0FF" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- 已登录状态 -->
                        <Border x:Name="LoggedInPanel" IsVisible="False" Background="#FFFFFF15" CornerRadius="14" Padding="14">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" x:Name="LoggedInDot" Fill="#8EE4AF" />
                                    <TextBlock x:Name="LoggedInStatus" Text="已登录" FontSize="13" Foreground="White" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource AccentPurple}">
                                        <TextBlock Text="👤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="LoggedInUsername" Text="用户名" FontSize="14" Foreground="White" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Classes="ghost" Click="OnLogout" Foreground="#FFE0D0FF" Height="32" Padding="0">
                                    <TextBlock Text="退出登录" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 全局下载进度 -->
                <Border Grid.Row="3" Margin="14,0,14,18" Padding="12" Background="#FFFFFF15" CornerRadius="12" IsVisible="False" x:Name="GlobalProgressBorder">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="GlobalProgressText" Text="下载中..." FontSize="12" Foreground="White" />
                        <ProgressBar x:Name="GlobalProgressBar" Classes="download" Minimum="0" Maximum="100" Value="0" Height="5" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="ContentArea" Margin="24">

                    <!-- 首页 -->
                    <StackPanel x:Name="HomePage" Spacing="22">
                        <StackPanel Spacing="6">
                            <TextBlock Text="准备好冒险了吗？" Classes="h1" />
                            <TextBlock Text="选择一个版本，点击开始！" Classes="body" />
                        </StackPanel>

                        <Border Classes="card">
                            <StackPanel Spacing="18">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="48" Height="48" CornerRadius="16" Background="{StaticResource AccentYellow}">
                                        <TextBlock Text="🎮" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="快速启动" Classes="h2" />
                                        <TextBlock Text="选择已安装的版本开始游戏" Classes="dim" />
                                    </StackPanel>
                                </StackPanel>

                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="12" ColumnSpacing="12">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="游戏版本" Classes="body" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="HomeVersionCombo" Classes="input" MinWidth="200" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="玩家名称" Classes="body" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="HomePlayerName" Classes="input" Text="Steve" MinWidth="200" />
                                </Grid>

                                <Button Classes="success" Click="OnLaunchGame" Content="▶️ 开始游戏" Height="46" FontSize="16" FontWeight="Bold" />
                            </StackPanel>
                        </Border>

                        <WrapPanel Spacing="12">
                            <Border Classes="card" MinWidth="170">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="已安装版本" Classes="dim" />
                                    <TextBlock x:Name="StatVersions" Text="0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" />
                                </StackPanel>
                            </Border>
                            <Border Classes="card" MinWidth="170">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="分配内存" Classes="dim" />
                                    <TextBlock x:Name="StatMemory" Text="2 GB" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentPurple}" />
                                </StackPanel>
                            </Border>
                            <Border Classes="card" MinWidth="170">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Java状态" Classes="dim" />
                                    <TextBlock x:Name="StatJava" Text="自动检测中..." FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentPink}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <!-- 下载页面 -->
                    <StackPanel x:Name="DownloadPage" Spacing="18" IsVisible="False">
                        <StackPanel Spacing="6">
                            <TextBlock Text="下载 Minecraft" Classes="h1" />
                            <TextBlock Text="从 Mojang 官方获取最新版本" Classes="body" />
                        </StackPanel>

                        <Border Classes="card">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBox x:Name="SearchVersionInput" Classes="input" Watermark="🔍 搜索版本..." TextChanged="OnSearchVersionChanged" />
                                    <Button Grid.Column="1" Classes="primary" Content="🔄 刷新" Click="OnRefreshVersionList" Margin="10,0,0,0" Padding="14,0" />
                                    <Button Grid.Column="2" Classes="success" Content="📥 下载选中" Click="OnDownloadVersion" Margin="10,0,0,0" Padding="14,0" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="FilterRelease" Classes="primary" Content="正式版" Click="OnFilterRelease" Padding="14,6" />
                                    <Button x:Name="FilterSnapshot" Classes="ghost" Content="快照" Click="OnFilterSnapshot" Padding="14,6" />
                                    <Button x:Name="FilterAll" Classes="ghost" Content="全部" Click="OnFilterAll" Padding="14,6" />
                                </StackPanel>
                                <TextBlock x:Name="VersionListStatus" Text="正在获取版本列表..." Classes="dim" />
                                <ListBox x:Name="DownloadVersionList" Height="400" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="8,10">
                                                <Border Width="12" Height="12" CornerRadius="6" Margin="0,0,12,0" VerticalAlignment="Center" Background="{StaticResource AccentGreen}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimary}" />
                                                    <TextBlock Text="{Binding Type}" Classes="dim" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding ReleaseDate}" Classes="dim" VerticalAlignment="Center" Margin="0,0,14,0" />
                                                <Border Grid.Column="3" Background="{StaticResource AccentBlue}" CornerRadius="8" Padding="10,4" VerticalAlignment="Center" IsVisible="{Binding IsLatest}">
                                                    <TextBlock Text="最新" FontSize="11" Foreground="White" FontWeight="Bold" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 已安装版本 -->
                    <StackPanel x:Name="VersionsPage" Spacing="18" IsVisible="False">
                        <StackPanel Spacing="6">
                            <TextBlock Text="已安装版本" Classes="h1" />
                            <TextBlock Text="管理你已经下载的游戏版本" Classes="body" />
                        </StackPanel>
                        <ItemsControl x:Name="VersionList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="card" Margin="0,6">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                                <TextBlock Classes="dim">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} · {1} MB">
                                                            <Binding Path="Type" />
                                                            <Binding Path="SizeMB" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{StaticResource AccentGreen}" CornerRadius="8" Padding="10,4" VerticalAlignment="Center" Margin="0,0,10,0" IsVisible="{Binding IsValid}">
                                                <TextBlock Text="有效" FontSize="11" Foreground="White" FontWeight="Bold" />
                                            </Border>
                                            <Button Grid.Column="2" Classes="primary" Content="选择启动" Click="OnSelectVersion" Tag="{Binding Id}" Padding="16,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 模组页面 -->
                    <StackPanel x:Name="ModsPage" Spacing="18" IsVisible="False">
                        <StackPanel Spacing="6">
                            <TextBlock Text="模组中心" Classes="h1" />
                            <TextBlock Text="发现和安装精彩的 Minecraft 模组" Classes="body" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox x:Name="SearchModsInput" Classes="input" Watermark="🔍 搜索模组..." TextChanged="OnSearchModsChanged" MinWidth="250" />
                            <Button Grid.Column="1" Classes="ghost" Content="清除" Click="OnClearModSearch" Margin="10,0,0,0" Padding="14,0" />
                        </Grid>
                        <ItemsControl x:Name="ModList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="card" Margin="0,6">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource AccentPink}" Margin="0,0,16,0">
                                                <TextBlock Text="🧩" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ItemName}" FontWeight="SemiBold" FontSize="15" />
                                                <TextBlock Text="{Binding Description}" Classes="dim" />
                                                <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,6,0,0">
                                                    <TextBlock Text="⬇️" Classes="dim" />
                                                    <TextBlock Text="{Binding Downloads}" Classes="dim" FontSize="12" />
                                                    <TextBlock Text="❤️" Classes="dim" />
                                                    <TextBlock Text="{Binding Likes}" Classes="dim" FontSize="12" />
                                                    <TextBlock Text="{Binding GameVersion}" Classes="dim" FontSize="12" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="primary" Content="下载" Click="OnDownloadResource" Tag="{Binding ItemId}" VerticalAlignment="Center" Padding="18,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 资源包页面 -->
                    <StackPanel x:Name="ResourcePacksPage" Spacing="18" IsVisible="False">
                        <StackPanel Spacing="6">
                            <TextBlock Text="资源包" Classes="h1" />
                            <TextBlock Text="个性化你的游戏界面" Classes="body" />
                        </StackPanel>
                        <ItemsControl x:Name="ResourcePackList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="card" Margin="0,6">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource AccentYellow}" Margin="0,0,16,0">
                                                <TextBlock Text="🎨" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ItemName}" FontWeight="SemiBold" FontSize="15" />
                                                <TextBlock Text="{Binding Description}" Classes="dim" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="primary" Content="下载" Click="OnDownloadResource" Tag="{Binding ItemId}" VerticalAlignment="Center" Padding="18,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 光影页面 -->
                    <StackPanel x:Name="ShadersPage" Spacing="18" IsVisible="False">
                        <StackPanel Spacing="6">
                            <TextBlock Text="光影效果" Classes="h1" />
                            <TextBlock Text="让 Minecraft 拥有梦幻般的画面" Classes="body" />
                        </StackPanel>
                        <ItemsControl x:Name="ShaderList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="card" Margin="0,6">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource AccentGreen}" Margin="0,0,16,0">
                                                <TextBlock Text="✨" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ItemName}" FontWeight="SemiBold" FontSize="15" />
                                                <TextBlock Text="{Binding Description}" Classes="dim" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="primary" Content="下载" Click="OnDownloadResource" Tag="{Binding ItemId}" VerticalAlignment="Center" Padding="18,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 材质包页面 -->
                    <StackPanel x:Name="TexturesPage" Spacing="18" IsVisible="False">
                        <StackPanel Spacing="6">
                            <TextBlock Text="材质包" Classes="h1" />
                            <TextBlock Text="改变方块和物品的外观" Classes="body" />
                        </StackPanel>
                        <ItemsControl x:Name="TextureList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="card" Margin="0,6">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource AccentPurple}" Margin="0,0,16,0">
                                                <TextBlock Text="🖼" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ItemName}" FontWeight="SemiBold" FontSize="15" />
                                                <TextBlock Text="{Binding Description}" Classes="dim" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="primary" Content="下载" Click="OnDownloadResource" Tag="{Binding ItemId}" VerticalAlignment="Center" Padding="18,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 整合包页面 -->
                    <StackPanel x:Name="ModpacksPage" Spacing="18" IsVisible="False">
                        <StackPanel Spacing="6">
                            <TextBlock Text="整合包" Classes="h1" />
                            <TextBlock Text="一键安装精心搭配的模组合集" Classes="body" />
                        </StackPanel>
                        <ItemsControl x:Name="ModpackList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="card" Margin="0,6">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource AccentBlue}" Margin="0,0,16,0">
                                                <TextBlock Text="🎁" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ItemName}" FontWeight="SemiBold" FontSize="15" />
                                                <TextBlock Text="{Binding Description}" Classes="dim" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="success" Content="安装" Click="OnDownloadResource" Tag="{Binding ItemId}" VerticalAlignment="Center" Padding="18,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

            <!-- 底部控制台 -->
            <Border Grid.Row="1" Background="#FF6B8FD9" BorderBrush="#FF8C9FE6" BorderThickness="0,1,0,0" MaxHeight="130">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="📋 控制台" Classes="dim" Margin="16,8,0,0" FontSize="12" Foreground="#FFE0D0FF" />
                    <ScrollViewer Grid.Row="1" Margin="0,4,0,0">
                        <TextBlock x:Name="ConsoleOutput" Text="准备就绪！" FontFamily="Consolas, Cascadia Code, monospace" FontSize="12" Foreground="#FFE0D0FF" TextWrapping="Wrap" Margin="16,0,16,12" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
